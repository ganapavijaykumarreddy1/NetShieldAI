# NetShield AI Environment Configurations

# Security settings
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=8c4e402e6bb45b8fb7b24329d66144e548efeb052b6ee0cdcaefbc13a078d2ab
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database configurations
# Format: postgresql://username:password@hostname:port/database_name
# If PostgreSQL is not active, backend will fallback to: sqlite:///./netshield_ai.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/netshield_db

# CORS Configuration
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Configuration (Milestone 3)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_app_password
SMTP_RECIPIENT_EMAIL=admin_email@gmail.com
